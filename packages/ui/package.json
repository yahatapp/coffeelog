{
  "name": "@yahatapp/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": {
      "types": "./src/styles/index.css.d.ts",
      "default": "./src/styles/index.css"
    },
    "./themes/brewlog.css": {
      "types": "./src/styles/themes/brewlog.css.d.ts",
      "default": "./src/styles/themes/brewlog.css"
    },
    "./themes/cafelog.css": {
      "types": "./src/styles/themes/cafelog.css.d.ts",
      "default": "./src/styles/themes/cafelog.css"
    }
  },
  "scripts": {
    "check": "tsc --noEmit",
    "build": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "catalog:",
    "@radix-ui/react-slot": "catalog:",
    "@tanstack/react-query": "catalog:",
    "clsx": "catalog:"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
