# -----------------------------------------------------------------------------
# Cafelog - Environment Variables Configuration Guide
# -----------------------------------------------------------------------------
# このプロジェクトでは、フロントエンド(Vite)とバックエンド(Cloudflare Workers/Hono)で
# 用途に合わせて環境変数を管理するファイルを分けます。
# 以下の構成を参考に、必要なファイルをローカルに作成してください。
# ※ 各ファイルは .gitignore に追加されており、Gitにはコミットされません。
# -----------------------------------------------------------------------------

# =============================================================================
# 1. フロントエンド（Vite）用環境変数
# =============================================================================
# ファイル名: .env.development (ローカル開発時: pnpm dev用)
#          : .env.production  (本番ビルド時: pnpm deploy用)
# 注意      : フロントエンドで使用する変数には必ず「VITE_」プレフィックスを付けます。
# =============================================================================

# [LINE Developers] フロントエンドの初期化（@line/liff）用 LIFF ID
# ※ Brewlogとは別のLINEチャネル（LINEログイン）で発行したLIFF IDを使用
VITE_LIFF_ID=your_cafelog_liff_id_here

# [Vite] ローカル開発時（ngrok等使用時）にアクセスを許可するホスト名（カンマ区切りで複数指定可能）
VITE_ALLOWED_HOSTS=your_ngrok_domain_here.ngrok-free.dev


# =============================================================================
# 2. バックエンド（Cloudflare Workers/Hono）用環境変数
# =============================================================================
# ファイル名: .dev.vars (ローカル開発時: wrangler dev または pnpm dev用)
# 注意      : ここに書いた値はローカルでのAPI実行時のみ読み込まれます。
#          : 本番環境（デプロイ後）の変数は `wrangler secret put` でCloudflareに登録します。
# =============================================================================

# [Database] HonoからSupabase/PostgreSQLに接続するための接続文字列
# ※ Brewlogと同じSupabase DBを使用（スキーマ 'cafelog' で分離）
DATABASE_URL=postgres://postgres:password@localhost:5432/postgres

# [Auth] バックエンドでの IDトークン検証に使用される LINE チャネル ID
# ※ Cafelog用の新しいLINEチャネルIDを使用
LINE_CHANNEL_ID=your_cafelog_line_channel_id_here

# [Auth] アプリの利用を許可する LINE ユーザー ID (sub) のカンマ区切りリスト
ALLOWED_LINE_USER_IDS=Uxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx,Uyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy


# =============================================================================
# 3. データベース・マイグレーション用（Drizzle ORM）
# =============================================================================
# ファイル名: .env (drizzle-kit 等のCLIツール用)
# 注意      : Drizzle Kit (pnpm run db:generate / db:migrate) は .env を参照します。
#          : .dev.vars と同じ DATABASE_URL を定義してください。
#          : Cafelog は 'cafelog' スキーマを使用します（drizzle.config.ts の schemaFilter）。
# =============================================================================

# [Database] Drizzle ORMやマイグレーションスクリプトが参照するDB接続文字列
DATABASE_URL=postgres://postgres:password@localhost:5432/postgres
