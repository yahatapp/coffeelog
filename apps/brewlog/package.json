{
  "name": "brewlog",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "browser:install": "playwright install chromium",
    "browser:install:with-deps": "playwright install --with-deps chromium",
    "check": "vp check",
    "check:fix": "vp check --fix",
    "guard:changes": "./scripts/guard-changes.sh",
    "guard:betterleaks-canary": "./scripts/check-betterleaks-canary.sh",
    "guard:secrets:ci": "./scripts/check-secrets-ci.sh",
    "hooks:install": "lefthook install",
    "test": "vp test",
    "deploy": "pnpm run build && wrangler deploy",
    "deploy:built": "wrangler deploy",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node ../../scripts/db-migrate.mjs brewlog"
  },
  "dependencies": {
    "@hono/zod-validator": "catalog:",
    "@line/liff": "catalog:",
    "@radix-ui/react-slot": "catalog:",
    "@tanstack/react-form": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@yahatapp/coffee-reference": "workspace:*",
    "@yahatapp/ui": "workspace:*",
    "base-ui": "catalog:",
    "clsx": "catalog:",
    "drizzle-orm": "catalog:",
    "hono": "catalog:",
    "jose": "catalog:",
    "lucide-react": "catalog:",
    "postgres": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router-dom": "catalog:",
    "tailwind-merge": "catalog:",
    "tailwindcss-animate": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "@playwright/test": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "autoprefixer": "catalog:",
    "drizzle-kit": "catalog:",
    "lefthook": "catalog:",
    "postcss": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
