{
  "name": "line-app",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.11.0",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "check": "turbo run check",
    "test": "turbo run test",
    "guard:changes": "turbo run guard:changes",
    "guard:betterleaks-canary": "turbo run guard:betterleaks-canary",
    "guard:secrets": "turbo run guard:secrets:ci",
    "deploy:brewlog": "pnpm --filter brewlog deploy",
    "deploy:cafelog": "pnpm --filter cafelog deploy"
  },
  "devDependencies": {
    "turbo": "^2.5.8"
  }
}
