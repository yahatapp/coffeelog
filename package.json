{
  "name": "coffeelog",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check": "pnpm check:design && turbo run check",
    "test": "pnpm test:design && turbo run test",
    "guard:changes": "turbo run guard:changes",
    "guard:betterleaks-canary": "./scripts/check-betterleaks-canary.sh",
    "guard:secrets:ci": "./scripts/check-secrets-ci.sh",
    "db:migrate": "node scripts/db-migrate.mjs all",
    "hooks:install": "lefthook install",
    "deploy:brewlog": "pnpm --filter brewlog deploy",
    "deploy:cafelog": "pnpm --filter cafelog deploy",
    "check:design": "stylelint \"packages/ui/src/**/*.css\" \"apps/*/src/**/*.css\" \"scripts/ui/**/*.css\" && node scripts/check-design-tokens.mjs && node scripts/check-css-modules.mjs && node scripts/check-legacy-styles.mjs && node scripts/check-design-docs.mjs && pnpm --filter brewlog exec tsc --project ../../scripts/ui/tsconfig.json",
    "test:design": "node --test scripts/check-design-tokens.test.mjs scripts/check-css-modules.test.mjs scripts/check-stylelint.test.mjs scripts/check-legacy-styles.test.mjs",
    "test:ui": "node scripts/ui/run.mjs",
    "css:types": "node scripts/generate-css-types.mjs",
    "ui:dev": "node scripts/ui/dev.mjs",
    "ui:report": "node scripts/ui/report.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@yahatapp/ui": "workspace:*",
    "lefthook": "catalog:",
    "postcss": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "stylelint": "17.16.0",
    "turbo": "^2.11.10",
    "vite-plus": "1.4.0"
  },
  "packageManager": "pnpm@11.11.0"
}
